# AutoOps local configuration template
#
# Copy the settings you need into .env and replace every CHANGE_ME or blank
# secret before running. Never commit .env, OAuth credentials, or Gmail tokens.

# Runtime
AUTOOPS_ENV=development
AUTOOPS_LOAD_DOTENV=true
AUTOOPS_VERSION=
AUTOOPS_API_BASE=http://localhost:8000
AUTOOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANONYMIZED_TELEMETRY=False

# PostgreSQL and Redis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=autoops
# Direct host execution uses localhost. Docker Compose builds its own database
# URL from POSTGRES_* so a host URL is never injected into a container.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/autoops
REDIS_URL=redis://localhost:6379/0
AUTOOPS_DOCKER_REDIS_URL=redis://redis:6379/0

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
AUTOOPS_DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Authentication and authorization
# Generate JWT_SECRET_KEY locally with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
AUTOOPS_ALLOW_MOCK_TOKEN=true
AUTOOPS_BOOTSTRAP_USERNAME=admin
AUTOOPS_BOOTSTRAP_PASSWORD=
AUTOOPS_BOOTSTRAP_ROLE=owner

# Local file access
# These are paths inside the Docker containers.
AUTOOPS_ALLOWED_ROOTS=/app:/mac/downloads:/mac/documents:/mac/desktop
AUTOOPS_INBOX=/app/inbox
AUTOOPS_BACKUP_DIR=/app/backups
CHROMA_PERSIST_DIR=/app/.cache/chroma_data

# Host folders mounted read-only by Docker Compose
# Blank values use $HOME/Downloads, $HOME/Documents, and $HOME/Desktop.
AUTOOPS_DOWNLOADS_DIR=
AUTOOPS_DOCUMENTS_DIR=
AUTOOPS_DESKTOP_DIR=

# Gmail OAuth
# Credentials.json stays local and the OAuth token is stored in a Docker volume.
GMAIL_CREDENTIALS_PATH=/app/Credentials.json
GMAIL_TOKEN_PATH=/app/.gmail/token.json
GMAIL_AUTH_HOST=localhost
GMAIL_AUTH_BIND_ADDR=0.0.0.0
GMAIL_AUTH_PORTS=8080,8081,8082,8083,8084
GMAIL_OPEN_BROWSER=false
MAX_EMAIL_CHARS=5000

# Agent and worker limits
MAX_TOOL_OUTPUT_CHARS=4000
SESSION_MEMORY_TTL_SECONDS=86400
AUTOOPS_TASK_SOFT_TIME_LIMIT=900
AUTOOPS_TASK_TIME_LIMIT=960

# API rate limits
AUTOOPS_RATE_LIMIT_ENABLED=true
AUTOOPS_RATE_LIMIT_REQUESTS_PER_MINUTE=600
AUTOOPS_RATE_LIMIT_JOB_SUBMITS_PER_MINUTE=20
AUTOOPS_RATE_LIMIT_WINDOW_SECONDS=60

# Service-level objectives
AUTOOPS_SLO_MAX_ACTIVE_JOBS=20
AUTOOPS_SLO_MAX_FAILED_JOB_RATIO=0.25
AUTOOPS_SLO_MAX_P95_LATENCY_MS=2000

# Backups
# Generate AUTOOPS_BACKUP_ENCRYPTION_KEY locally with:
# venv/bin/python scripts/generate_backup_key.py
AUTOOPS_BACKUP_ENCRYPT_BY_DEFAULT=false
AUTOOPS_BACKUP_ENCRYPTION_KEY=
AUTOOPS_BACKUP_INCLUDE_SECRETS=false
AUTOOPS_ENABLE_RESTORE=false

# Optional encrypted secrets file
# Leave disabled for normal local development.
AUTOOPS_REQUIRE_ENCRYPTED_SECRETS=false
AUTOOPS_SECRETS_FILE=
AUTOOPS_SECRETS_KEY=
